# DEV SAMPLE -> copy to /etc/hydra-headless-ts/dbhub.env
#
# Staging and prod render this from salt/dbhub/env.tmpl.jinja2, which emits
# exactly these two keys and nothing else. The password lives here rather than in
# dbhub.toml because DBHub resolves ${DBHUB_DB_PASSWORD} from its process
# environment when it loads the TOML -- that keeps the credential out of a file
# that is safe to read and to render into a snapshot baseline.
#
# Salt writes the deployed copy 0640. Do the same locally if the password is real.
DBHUB_DB_PASSWORD=change-me
LOG_LEVEL=info
