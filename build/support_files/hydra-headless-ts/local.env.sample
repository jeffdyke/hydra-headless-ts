# DEV SAMPLE -> copy to /etc/hydra-headless-ts/local.env, then fill in the
# Google secrets. /etc/hydra-headless-ts/hydra.env is a symlink to that file.
#
#   cp /etc/hydra-headless-ts/local.env /etc/hydra-headless-ts/local.env.bak
#   cp build/support_files/hydra-headless-ts/local.env.sample /etc/hydra-headless-ts/local.env
#
# The file currently on a workstation is a STAGING clone pointing at
# auth.staging.bondlink.org and the VPC address 10.1.1.230. This variant moves it
# onto the compose network and the nginx entry point at http://localhost:8888.
# Secrets are intentionally blank -- copy the real values out of your backup.

# NOT `local`. src/fp/config.ts:124 treats APP_ENV=local specially in two ways
# that both break this setup:
#   1. googleConfig() returns clientId/clientSecret = undefined (config.ts:268),
#      so Google OAuth is silently disabled and login fails with no credentials.
#   2. domainConfig() forces domain.public AND domain.private to $LOCAL_DOMAIN
#      (default "localhost"), ignoring PUBLIC_DOMAIN/PRIVATE_HOST below -- which
#      makes the /oauth2/auth proxy target http://localhost:4444 *inside the
#      headless-ts container*, where nothing is listening.
# `development` takes the normal code path with local values.
APP_ENV=development

BASE_URL=http://localhost:8888
PUBLIC_DOMAIN=localhost
# Compose service name, not an IP. src/fp/config.ts:447 builds the internal
# /oauth2/auth proxy target as http://$PRIVATE_HOST:<hydra public port>, and that
# request is made from inside the headless-ts container.
PRIVATE_HOST=hydra
EMAIL_ALLOWLIST_PATH=/etc/hydra-headless-ts/allowed_emails.txt

# Hydra
# Advertised only, never fetched, while JWT_PROVIDER=google -- token verification
# uses Google's JWKS. If you switch to JWT_PROVIDER=hydra this becomes a
# server-side fetch target and "localhost" is wrong from inside the container.
HYDRA_PUBLIC_URL=http://localhost:8888
HYDRA_ADMIN_HOST=hydra
HYDRA_ADMIN_PORT=4445
# Filled in by scripts/dev-register-client.sh; a fresh postgres volume
# (docker compose down -v) invalidates it and you must re-register.
AUTH_FLOW_CLIENT_ID=

# Redis
# The staging clone has the literal string "None" here.
REDIS_HOST=redis
REDIS_PORT=6379

# Database

POSTGRES_HOST=postgres
DSN=postgres://hydra:my-super-secret-password@postgres:5432/hydra?sslmode=disable


# Google OAuth
# http://localhost:8888/callback must be an Authorized redirect URI on this
# client in the Google console -- exact match, so the port matters. Reusing the
# staging client keeps JWT_AUDIENCE and allowed_emails.txt valid; a separate
# local client means changing GOOGLE_CLIENT_ID and JWT_AUDIENCE together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8888/callback
# src/fp/config.ts:372, used by the middleware; same value, separate variable.
REDIRECT_URL=http://localhost:8888/callback
# DCR_ORIGIN_REDIRECT_URI is deliberately unset: it defaults to
# https://claude.ai/api/mcp/auth_callback (config.ts:376) and is NOT derived from
# BASE_URL, so it needs no local override.
JWT_PROVIDER=google
JWT_ISSUER=https://accounts.google.com
# Must equal GOOGLE_CLIENT_ID.
JWT_AUDIENCE=
