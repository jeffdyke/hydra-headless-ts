# DEV SAMPLE -> copy to /etc/hydra-headless-ts/mariadb-mcp-example.env
#
# One of N named mariadb-mcp connections (see
# docker-compose.mariadb-mcp.dev.yml's mariadb-mcp-example service and
# build/nginx/dev/conf.d/hydra.conf's /db-tools/example location). Unlike the
# default instance (mariadb-mcp.env, ungated bare /db-tools), this one IS
# gated -- see allowed_emails_example.txt.
#
# Same eager-connect/crash-loop behavior as the default instance: point DB_HOST
# at a database you can actually reach before `docker compose up` will settle.
#
# LOG_FILE must be distinct per instance -- every mariadb-mcp container shares
# the same /var/log/bondlink bind mount, and the app writes a fixed filename
# under whatever LOG_FILE names, so two instances with the same value silently
# clobber each other's log.
DB_HOST=host.docker.internal
DB_USER=claude-mariadb
DB_PASSWORD=change-me
DB_PORT=3306
DB_NAME=BondLink
MCP_READ_ONLY=true
MCP_MAX_POOL_SIZE=10
LOG_FILE=/var/log/bondlink/mariadb-mcp-example.log
