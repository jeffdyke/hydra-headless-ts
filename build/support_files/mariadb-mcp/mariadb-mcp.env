# DEV SAMPLE -> copy to /etc/hydra-headless-ts/mariadb-mcp.env
#
# Unlike DBHub, mariadb-mcp builds its connection pool EAGERLY at startup and
# exits(1) when the database is unreachable -- it crash-loops rather than
# starting degraded. So this has to name a database that actually answers before
# `docker compose up` will settle.
#
# host.docker.internal reaches a MariaDB running on your own machine; point it
# somewhere else if yours lives elsewhere. This used to say `stagingdb03`, which
# does not resolve from a workstation, so a fresh bootstrap left the container
# restarting forever with:
#   asyncmy.errors.OperationalError: (2003, "Can't connect to MySQL server on
#   'stagingdb03' ([Errno -2] Name or service not known)")
#
# DB_PASSWORD is a PLACEHOLDER. Put the real one here AND the same value in
# dbhub.env's DBHUB_DB_PASSWORD -- both services connect as this same read-only
# user, and a mismatch surfaces only as a pool timeout from whichever is wrong,
# which reads like an unreachable database rather than a bad credential.
DB_HOST=host.docker.internal
DB_USER=claude-mariadb
DB_PASSWORD=change-me
DB_PORT=3306
DB_NAME=BondLink
MCP_READ_ONLY=true
MCP_MAX_POOL_SIZE=10
