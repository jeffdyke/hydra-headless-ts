FROM node:23-alpine3.20

ARG ENV_FILE_PREFIX="staging"
ENV ENV_SUBCOMMAND="${ENV_FILE_PREFIX}"
ARG BRANCH_NAME="RC"
RUN mkdir -p /usr/src/app

WORKDIR /usr/src/app
RUN apk add --no-cache vim git bash postgresql-client openssh-client

RUN mkdir -p -m 0755 ~/.ssh \
    && ssh-keyscan github.com >> ~/.ssh/known_hosts

RUN --mount=type=ssh git clone --branch ${BRANCH_NAME} --single-branch git@github.com:mblink/hydra-headless-ts.git /tmp/repo \
    && cp -rf /tmp/repo/* /usr/src/app \
    && npm install \
    && npm run build \
    && rm -rf /tmp/repo

VOLUME [ "/var/log/hydra-headless-ts", "/etc/hydra-headless-ts" ]

ENTRYPOINT ["npm", "run", "serve:staging"]

EXPOSE 3000
