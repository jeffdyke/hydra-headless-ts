FROM node:22-alpine3.20

WORKDIR /src/app
ARG GIT_BRANCH=RC
RUN apk add --no-cache vim git bash postgresql-client \
  && mkdir -p /tmp/repo \
  && git clone --depth 1 --branch $GIT_BRANCH https://$GIT_TOKEN@github.com/mblink/hydra-headless-ts.git .

RUN ls -l package.json \
  && npm install \
  && npm run build

COPY build/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

VOLUME [ "/var/log/hydra-headless-ts", "/etc/hydra-headless-ts" ]

ENTRYPOINT ["/entrypoint.sh"]

EXPOSE 3000
